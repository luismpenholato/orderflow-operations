# OrderFlow Operations — Environment Configuration
# Copy to /opt/orderflow/.env and adjust values.
# NEVER commit real secrets to version control.

# --- General ---
NODE_ENV=production

# --- Database ---
DATABASE_URL=postgresql://orderflow:CHANGE_ME@localhost:5432/orderflow

# --- API ---
API_PORT=3000
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=8h
COOKIE_SECURE=true
CORS_ORIGIN=https://orderflow.example.com
LOG_LEVEL=info

# --- Outbox Worker ---
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_RETRIES=5
OUTBOX_BATCH_SIZE=10

# --- ERP Mock ---
ERP_MOCK_PORT=3001
ERP_MOCK_URL=http://127.0.0.1:3001
ERP_MOCK_FAILURE_RATE=0

# --- Rate Limiting ---
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
