# Database
DATABASE_URL=postgresql://orderflow:orderflow_dev@localhost:5432/orderflow

# API
API_PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ERP Mock
ERP_MOCK_URL=http://localhost:3001
ERP_REQUEST_TIMEOUT_MS=10000
ERP_MOCK_PORT=3001
ERP_MOCK_FAILURE_RATE=0

# Outbox Worker
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_RETRIES=5
OUTBOX_BATCH_SIZE=10

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
